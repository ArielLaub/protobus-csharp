<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../src/Protobus.Tools/build/Protobus.Tools.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- The generator built from this repository, not a packaged one. -->
    <ProtobusCodegenDll>$(MSBuildThisFileDirectory)../../src/Protobus.Codegen/bin/$(Configuration)/net8.0/protobus-csharp.dll</ProtobusCodegenDll>
  </PropertyGroup>

  <ItemGroup>
    <ProtobusSchemas Include="../schemas" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- As a Protobus.Tools consumer has it: restored, its own targets not imported. -->
    <PackageReference Include="Grpc.Tools" ExcludeAssets="all" PrivateAssets="all" />
    
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Protobus/Protobus.csproj" />
    <ProjectReference Include="../../src/Protobus.Codegen/Protobus.Codegen.csproj" />
  </ItemGroup>

  <!-- The generator tests run the protoc Grpc.Tools resolved for this machine. -->
  <Target Name="_ProtocForTests" BeforeTargets="CoreGenerateAssemblyInfo" DependsOnTargets="_ProtobusResolveProtoc">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>Protoc</_Parameter1>
        <_Parameter2>$(_ProtobusProtoc)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Import Project="../../src/Protobus.Tools/build/Protobus.Tools.targets" />
</Project>
